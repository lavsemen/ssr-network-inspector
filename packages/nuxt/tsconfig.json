{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "#imports": ["./src/shims.d.ts"],
      "#app": ["./src/shims.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/unit/**/*.ts",
