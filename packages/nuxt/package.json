{
  "name": "@lavsemen/ssr-network-inspector",
  "version": "0.1.4",
  "description": "Nuxt module that captures SSR fetches for Chrome DevTools SSR Network Inspector",
  "type": "module",
  "license": "MIT",
  "author": "lavsemen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavsemen/ssr-network-inspector.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://github.com/lavsemen/ssr-network-inspector#readme",
  "bugs": {
    "url": "https://github.com/lavsemen/ssr-network-inspector/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "ssr",
    "devtools",
    "network-inspector",
    "ofetch"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:unit && pnpm test:module",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:module": "vitest run --config vitest.module.config.ts"
  },
  "dependencies": {
    "@nuxt/kit": "^3.10.0 || ^4.0.0",
    "defu": "^6.1.4",
    "h3": "^1.10.0",
    "ofetch": "^1.4.0",
    "ufo": "^1.6.1"
  },
  "peerDependencies": {
    "nuxt": ">=3.10.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@lavsemen/ssr-network-inspector-protocol": "workspace:*",
    "@nuxt/module-builder": "^1.0.1",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/test-utils": "^3.19.2",
    "@types/node": "^22.16.5",
    "nuxt": "^4.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.17"
  }
}
