{
  "name": "@lavsemen/ssr-network-inspector-protocol",
  "version": "0.1.1",
  "description": "Shared protocol types and guards for SSR Network Inspector",
  "type": "module",
  "license": "MIT",
  "author": "lavsemen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavsemen/ssr-network-inspector.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/lavsemen/ssr-network-inspector#readme",
  "bugs": {
    "url": "https://github.com/lavsemen/ssr-network-inspector/issues"
  },
  "keywords": [
    "ssr",
    "nuxt",
    "devtools",
    "network-inspector"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
